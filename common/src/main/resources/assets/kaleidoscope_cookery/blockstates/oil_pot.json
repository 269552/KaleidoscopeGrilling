    { "when": { "facing": "west",  "has_oil": "true", "grilling_oil": "secret_chili" }, "apply": { "model": "kaleidoscope_grilling:block/oil_pot_secret_chili", "y": 270 } },

    { "when": { "facing": "north", "has_oil": "true", "grilling_oil": "premium_chili" }, "apply": { "model": "kaleidoscope_grilling:block/oil_pot_premium_chili" } },
