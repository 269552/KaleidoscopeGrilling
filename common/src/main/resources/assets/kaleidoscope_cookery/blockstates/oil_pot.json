    { "when": { "facing": "west",  "has_oil": "false" }, "apply": { "model": "kaleidoscope_cookery:block/oil_pot", "y": 270 } },

    { "when": { "facing": "north", "has_oil": "true", "grilling_oil": "default" }, "apply": { "model": "kaleidoscope_cookery:block/oil_pot_with_oil" } },
