    { "when": { "facing": "west",  "has_oil": "true", "grilling_oil": "canola" }, "apply": { "model": "kaleidoscope_grilling:block/oil_pot_canola", "y": 270 } },

    { "when": { "facing": "north", "has_oil": "true", "grilling_oil": "secret_chili" }, "apply": { "model": "kaleidoscope_grilling:block/oil_pot_secret_chili" } },
