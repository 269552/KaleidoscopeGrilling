    { "when": { "facing": "south", "has_oil": "true", "grilling_oil": "premium_chili" }, "apply": { "model": "kaleidoscope_grilling:block/oil_pot_premium_chili", "y": 180 } },
    { "when": { "facing": "west",  "has_oil": "true", "grilling_oil": "premium_chili" }, "apply": { "model": "kaleidoscope_grilling:block/oil_pot_premium_chili", "y": 270 } },
